import React, { useState, useEffect } from 'react';
import { View, StyleSheet, ScrollView, Image, TouchableOpacity } from 'react-native';
import { Text, Button, TextInput, Avatar, Portal, Modal, ActivityIndicator, List, Divider, FAB, Surface, HelperText, Chip, IconButton } from 'react-native-paper';
import { useLocalSearchParams, useRouter } from 'expo-router';
import { useAuth } from '../../../app/context/AuthContext';
import { clubApi } from '../../../shared/api/club';
import { UserApi } from '../../../shared/api/user';
import type { Club, ClubLocation } from '../../../shared/types/club';
import type { User } from '../../../shared/types/user-unified';
import { useClubModal } from '../../../app/context/ClubModalContext';
import { ClubModals } from '../../../app/components/club/ClubModals';
import { ImageService } from '../../services/imageService';

console.log('=== [id].tsx page loaded ===');

export default function ClubDetailScreen() {
  const { id } = useLocalSearchParams();
  const router = useRouter();
  const { currentUser } = useAuth();
  const [club, setClub] = useState<Club | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [isEditing, setIsEditing] = useState(false);
  const [editedClub, setEditedClub] = useState<Partial<Club>>({});
  const [showAddAdminModal, setShowAddAdminModal] = useState(false);
  const [showAddMemberModal, setShowAddMemberModal] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [searchResults, setSearchResults] = useState<User[]>([]);
  const [searching, setSearching] = useState(false);
  const { openModal, closeModal, modalType, modalProps } = useClubModal();

  useEffect(() => {
    fetchClubDetails();
  }, [id]);

  const fetchClubDetails = async () => {
    try {
      setIsLoading(true);
      const response = await clubApi.getClub(id as string);
      if (response.data) {
        setClub(response.data);
        setError(null);
      } else {
        setError('Failed to load club details');
      }
    } catch (err: any) {
      setError(err.message || 'Failed to load club details');
    } finally {
      setIsLoading(false);
    }
  };

  const handleUpdateClub = async (formData: FormData) => {
    if (!club) return;
    try {
      const response = await clubApi.updateClub(club._id, formData);
      if (response.data) {
        setClub(response.data);
        setError(null);
      } else {
        setError('Failed to update club');
      }
    } catch (err: any) {
      setError(err.message || 'Failed to update club');
    }
  };

  const handleSearchUsers = async (query: string) => {
    if (!query.trim()) {
      setSearchResults([]);
      return;
    }
    setSearching(true);
    try {
      // TODO: 实现用户搜索功能
      setSearchResults([]);
    } catch (error) {
      setError('Error searching users');
    } finally {
      setSearching(false);
    }
  };

  const handleAddAdmin = async (userId: string) => {
    if (!club) return;
    try {
      const response = await clubApi.addAdmin(club._id, userId);
      if (response.data) {
        setClub(response.data);
        setError(null);
      } else {
        setError('Failed to add admin');
      }
    } catch (err: any) {
      setError(err.message || 'Failed to add admin');
    }
  };

  const handleAddMember = async (userId: string) => {
    if (!club) return;
    try {
      const formData = new FormData();
      formData.append('members', userId);
      const response = await clubApi.updateClub(club._id, formData);
      if (response.data) {
        setClub(response.data);
        setError(null);
      } else {
        setError('Failed to add member');
      }
    } catch (err: any) {
      setError(err.message || 'Failed to add member');
    }
  };

  const handleLocationChange = (field: keyof ClubLocation, value: string) => {
    setEditedClub(prev => ({
      ...prev,
      location: {
        ...prev.location,
        [field]: value
      } as ClubLocation
    }));
  };

  const getImageUrl = (path?: string) => {
    if (!path) return undefined;
    return path.startsWith('http') ? path : `${process.env.EXPO_PUBLIC_API_URL}${path}`;
  };

  const handleClubUpdate = async (updatedClub: Club) => {
    // 使用 ImageService 处理图片URL
    const clubWithFullUrls = {
      ...updatedClub,
      logo: ImageService.getImageUrl(updatedClub.logo),
      coverImage: ImageService.getImageUrl(updatedClub.coverImage)
    };
    setClub(clubWithFullUrls);
    setError(null);
  };

  const handleModalClose = () => {
    closeModal();
    // 刷新俱乐部信息
    fetchClubDetails();
  };

  if (isLoading) {
    return (
      <View style={styles.loadingContainer}>
        <ActivityIndicator size="large" />
      </View>
    );
  }

  if (!club) {
    return (
      <View style={styles.errorContainer}>
        <Text>Club not found</Text>
      </View>
    );
  }

  // console.log('=== ClubDetail will render ===', club);

  // 权限判断兼容 _id 和 userId
  const getId = (user: any) => user?._id || user?.userId;
  const isAdmin = currentUser && (club.admins.some(admin => getId(admin) === getId(currentUser)) || getId(club.founder) === getId(currentUser));
  const isFounder = currentUser && getId(club.founder) === getId(currentUser);

  return (
    <ScrollView style={styles.container}>
      {/* Club Header */}
      <View style={styles.header}>
        {club.coverImage ? (
          <Image 
            source={{ uri: ImageService.getImageUrl(club.coverImage) }} 
            style={styles.coverImage}
            onError={() => setError('Failed to load cover image')}
          />
        ) : (
          <View style={styles.coverPlaceholder} />
        )}
        {isAdmin && (
          <IconButton
            icon="pencil"
            size={24}
            style={{ position: 'absolute', top: 8, right: 8, backgroundColor: 'rgba(255,255,255,0.7)' }}
            onPress={() => openModal('UPDATE_COVER', { club })}
          />
        )}
        <View style={styles.headerContent}>
          {club.logo ? (
            <Image 
              source={{ uri: ImageService.getImageUrl(club.logo) }} 
              style={styles.logo}
              onError={() => setError('Failed to load logo')}
            />
          ) : (
            <View style={styles.logoPlaceholder} />
          )}
          {isAdmin && (
            <IconButton
              icon="pencil"
              size={20}
              style={{ position: 'absolute', left: 70, bottom: 10, backgroundColor: 'rgba(255,255,255,0.7)' }}
              onPress={() => openModal('UPDATE_LOGO', { club })}
            />
          )}
          <View style={styles.headerText}>
            <Text variant="headlineMedium">{club.name}</Text>
            <Text variant="bodyMedium">ID: {club._id}</Text>
          </View>
          {isAdmin && (
            <IconButton
              icon="pencil"
              size={24}
              onPress={() => {
                setEditedClub(club);
                setIsEditing(true);
              }}
            />
          )}
        </View>
      </View>

      {/* Club Info */}
      <Surface style={styles.infoCard} elevation={2}>
        <View style={styles.infoHeader}>
          <Text variant="titleLarge">Club Information</Text>
          {isAdmin && (
            <IconButton
              icon="pencil"
              size={20}
              onPress={() => openModal('EDIT_INFO', { club })}
            />
          )}
        </View>
        <Divider />
        <View style={styles.infoContent}>
          <View style={styles.infoRow}>
            <Text variant="bodyMedium" style={styles.label}>Type:</Text>
            <Chip>{club.type}</Chip>
          </View>
          {club.location && (
            <View style={styles.infoRow}>
              <Text variant="bodyMedium" style={styles.label}>Location:</Text>
              <Text variant="bodyMedium">{`${club.location.city}, ${club.location.country}`}</Text>
            </View>
          )}
          {club.description && (
            <View style={styles.infoRow}>
              <Text variant="bodyMedium" style={styles.label}>Description:</Text>
              <Text variant="bodyMedium">{club.description}</Text>
            </View>
          )}
          <View style={styles.infoRow}>
            <Text variant="bodyMedium" style={styles.label}>Members:</Text>
            <Text variant="bodyMedium">{club.stats.memberCount}</Text>
          </View>
          {club.stats.activityCount !== undefined && (
            <View style={styles.infoRow}>
              <Text variant="bodyMedium" style={styles.label}>Activities:</Text>
              <Text variant="bodyMedium">{club.stats.activityCount}</Text>
            </View>
          )}
        </View>
      </Surface>

      {/* Admin Section */}
      {isAdmin && (
        <Surface style={styles.adminCard} elevation={2}>
          <View style={styles.adminHeader}>
            <Text variant="titleLarge">Admin Controls</Text>
          </View>
          <Divider />
          <View style={styles.adminContent}>
            <Button
              mode="contained"
              onPress={() => setShowAddAdminModal(true)}
              style={styles.adminButton}
            >
              Add Admin
            </Button>
            <Button
              mode="contained"
              onPress={() => setShowAddMemberModal(true)}
              style={styles.adminButton}
            >
              Add Member
            </Button>
          </View>
        </Surface>
      )}

      {/* Modals */}
      <ClubModals
        visible={!!modalType}
        type={modalType}
        club={club}
        onDismiss={handleModalClose}
        onUpdate={handleClubUpdate}
      />
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#f5f5f5',
  },
  loadingContainer: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
  },
  errorContainer: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    padding: 20,
  },
  header: {
    position: 'relative',
    height: 200,
  },
  coverImage: {
    width: '100%',
    height: '100%',
  },
  coverPlaceholder: {
    width: '100%',
    height: '100%',
    backgroundColor: '#e0e0e0',
  },
  headerContent: {
    position: 'absolute',
    bottom: 0,
    left: 0,
    right: 0,
    padding: 16,
    flexDirection: 'row',
    alignItems: 'flex-end',
    backgroundColor: 'rgba(0, 0, 0, 0.5)',
  },
  logo: {
    width: 80,
    height: 80,
    borderRadius: 40,
    borderWidth: 2,
    borderColor: '#fff',
  },
  logoPlaceholder: {
    width: 80,
    height: 80,
    borderRadius: 40,
    backgroundColor: '#e0e0e0',
    borderWidth: 2,
    borderColor: '#fff',
  },
  headerText: {
    flex: 1,
    marginLeft: 16,
  },
  infoCard: {
    margin: 16,
    padding: 16,
    borderRadius: 8,
  },
  infoHeader: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: 8,
  },
  infoContent: {
    marginTop: 8,
  },
  infoRow: {
    flexDirection: 'row',
    alignItems: 'center',
    marginVertical: 4,
  },
  label: {
    width: 100,
    fontWeight: 'bold',
  },
  adminCard: {
    margin: 16,
    padding: 16,
    borderRadius: 8,
  },
  adminHeader: {
    marginBottom: 8,
  },
  adminContent: {
    marginTop: 8,
  },
  adminButton: {
    marginVertical: 4,
  },
  modal: {
    backgroundColor: 'white',
    padding: 20,
    margin: 20,
    borderRadius: 8,
    maxHeight: '80%',
  },
  modalTitle: {
    marginBottom: 16,
  },
  searchInput: {
    marginBottom: 16,
  },
  searchLoading: {
    marginTop: 16,
  },
  searchResults: {
    maxHeight: 300,
  },
}); 