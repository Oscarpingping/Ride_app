# Frontend Environment Variables
# API Configuration
EXPO_PUBLIC_API_URL=http://3.139.190.107:5001

# Nginx Configuration for static files and uploads
EXPO_PUBLIC_NGINX_URL=http://3.139.190.107

# Development/Production Environment
NODE_ENV=production

# App Configuration
EXPO_PUBLIC_APP_NAME=WildPals
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
EXPO_PUBLIC_ENABLE_DEBUG_MODE=false
EXPO_PUBLIC_ENABLE_ANALYTICS=true

# External Services (if needed)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# WebSocket Configuration
EXPO_PUBLIC_WEBSOCKET_URL=ws://3.139.190.107:5001

# Image Upload Configuration
EXPO_PUBLIC_MAX_IMAGE_SIZE=5242880
EXPO_PUBLIC_SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif

# Cache Configuration
EXPO_PUBLIC_CACHE_DURATION=86400 